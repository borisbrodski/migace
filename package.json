{
  "name": "migace-workspace",
  "private": true,
  "type": "module",
  "description": "MIG-Ace: provable schema migrations for PostgreSQL and Hibernate.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "npm": ">=10.2.3"
  },
  "volta": {
    "node": "22.22.2"
  },
  "workspaces": [
    "migql",
    "core"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present && vitest run --dir tools",
    "test:generate": "npm run test:generate --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "~2.0.5"
  }
}
