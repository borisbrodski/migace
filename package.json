{
  "name": "migace-workspace",
  "private": true,
  "type": "module",
  "description": "MIG-Ace: provable schema migrations for PostgreSQL and Hibernate.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "npm": ">=10.2.3"
  },
  "volta": {
    "node": "22.22.2"
  },
  "workspaces": [
    "core",
    "migql",
    "databases/postgresql"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present && vitest run --dir tools && npm run test:java",
    "test:java": "node tools/java.mjs check",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:mutation": "stryker run",
    "test:generate": "npm run test:generate --workspaces --if-present",
    "test:server": "npm run build && node tools/java.mjs jar copyDriver && npm run test:server --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~2.0.5",
    "eslint": "^9.39.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "~2.0.5"
  }
}
