---
import Base from '../layouts/Base.astro';
import { Code } from 'astro:components';
import CompareDiagram from '../components/CompareDiagram.astro';
import CompletionDemo from '../components/CompletionDemo.astro';

const themes = { light: 'github-light', dark: 'one-dark-pro' } as const;

const make = `$ mig make

  + column customer.loyalty_level varchar(10), mandatory

The new column is mandatory. Rows that already exist need a value.
Which value should they get?
> 'BRONZE'

Wrote migrations/20260302-0900-customer-loyalty.migql.yaml`;

const snippet = `migration: 20260302-0900-customer-loyalty
doc: Every customer gets a loyalty level

parts:
  - add-column:
      do: |
        alter table customer
        add column loyalty_level varchar(10)

  - fill-existing:
      do: update customer set loyalty_level = 'BRONZE'

  - make-mandatory:
      do: |
        alter table customer
        alter column loyalty_level set not null`;

const plainNames = `parts:
  - orders-add-column-status-id:
  - orders-add-constraint-fk-orders-status:
  - orders-alter-column-status-id-set-not-null:`;

const llmNames = `doc: The order status moves from free text into a table

parts:
  - add-status-id:
  - status-fk:
  - status-mandatory:`;

const features = [
  ['✨', 'Written for you', 'Change an entity and run mig make. MIG-Ace writes the snippet and asks only for what it cannot know.', '/docs/generated-snippets/'],
  ['🎯', 'Proven, not assumed', 'Every build migrates a real older database and compares the result with the schema your application expects.', '/docs/proof-loop/'],
  ['✍️', 'An editor that knows your schema', 'Completion for tables, columns, constraints and keywords, as they exist at that point in your history.', '/docs/editor-support/'],
  ['🧮', 'Data migrations', 'Update millions of rows in batches, and state what must be true before and after.', '/docs/data-migrations/'],
  ['🧪', 'Test data built in', 'Each snippet brings rows that exercise it, so a NOT NULL column fails in the build and not in production.', '/docs/test-data/'],
  ['🩹', 'Made for mistakes', 'Fix a released snippet, repair the databases that already ran it, and keep an exact record of both.', '/docs/fixing-mistakes/'],
  ['🌿', 'Branches and hotfixes', 'Snippets from parallel branches merge as plain files. Release files remember what each release shipped.', '/docs/releases-and-branches/'],
  ['🚦', 'Zero-downtime checks', 'MIG-Ace tells you when a change would break an older application version that is still running.', '/docs/zero-downtime/'],
  ['☕', 'Runs from your JAR', 'The build puts one SQL script into your application. One line of Java runs it at start-up.', '/docs/running-migrations/'],
];

const tech = [
  ['TypeScript', 'The MIG-Ace tool itself: the compiler, the comparison and the commands.', 'https://www.typescriptlang.org'],
  ['Langium', 'The snippet language and its language server are built with this language framework.', 'https://langium.org'],
  ['PGlite', 'A real PostgreSQL that runs in memory. It powers the editor and mig make, with nothing to install.', 'https://pglite.dev'],
  ['PostgreSQL', 'The proof loop runs on the same PostgreSQL version as your production database.', 'https://www.postgresql.org'],
  ['Language Server Protocol', 'One language server for VS Code, IntelliJ IDEA, Neovim and other editors.', 'https://microsoft.github.io/language-server-protocol/'],
  ['YAML', 'Every snippet is a valid YAML file, readable in any editor and in any code review.', 'https://yaml.org'],
  ['Java and JDBC', 'A small runner library sends the migration script to the database from your application.', '/docs/running-migrations/'],
  ['Gradle', 'A plugin adds the commands to your build and puts the script into your JAR.', '/docs/getting-started/'],
  ['Your LLM', 'Optional. Any OpenAI-compatible endpoint can name and group generated snippets.', '/docs/generated-snippets/'],
];
---
<Base title="MIG-Ace · Migrations written for you and proven on real data">

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="badges">
          <span class="badge">PostgreSQL</span>
          <span class="badge">Hibernate · Jakarta EE</span>
          <span class="badge warm">Under construction</span>
        </div>
        <h1>Migrations written for you, <span class="brand-text">proven on real data.</span></h1>
        <p class="hero-sub">
          Change a Hibernate entity and run one command. MIG-Ace <b>writes</b> the PostgreSQL migration,
          asks what should happen to the rows you already have, and
          then <b>proves</b> that the result is exactly the schema your application expects.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/docs/getting-started/">Get started</a>
          <a class="btn btn-ghost" href="/docs/generated-snippets/">See what is generated</a>
        </div>
      </div>
      <div class="hero-demo">
        <div class="codebox">
          <div class="codebox-head"><span>You changed the Customer entity. Then:</span></div>
          <Code code={make} lang="text" themes={themes} />
        </div>
        <div class="codebox">
          <div class="codebox-head"><span>What MIG-Ace wrote</span></div>
          <Code code={snippet} lang="yaml" themes={themes} />
        </div>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="how">
    <div class="container">
      <h2>One comparison does both jobs</h2>
      <p class="lead">MIG-Ace builds the database your application expects and migrates an older copy of
        your real one. Then it compares them. While you develop, the difference becomes your next snippet.
        In every build, no difference is the proof.</p>
      <CompareDiagram />
      <p class="after"><a href="/docs/proof-loop/">Read how the proof loop works</a></p>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="editor">
    <div class="container split">
      <div>
        <h2>An editor that knows your schema</h2>
        <p>The MIG-Ace language server keeps your schema in memory. While you type a statement,
          it offers the tables and columns that exist <b>at that point</b> in your migration history,
          including a column that an earlier part of the same snippet adds.</p>
        <p>It completes keywords, tables, columns, constraints, sequences, functions and snippet names.
          It also runs your statement on an in-memory PostgreSQL and shows the real error while you type.</p>
        <p><a class="btn btn-ghost" href="/docs/editor-support/">See everything it completes</a></p>
      </div>
      <div>
        <CompletionDemo />
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="llm">
    <div class="container split">
      <div>
        <h2>An LLM for the part machines are bad at</h2>
        <p>Finding out <em>what</em> has to change is exact work, and MIG-Ace does it by comparing databases.
          Deciding how to group changes and what to call them is a matter of language. For that,
          MIG-Ace can use a language model.</p>
        <ul class="ticks">
          <li>It names snippets and parts, and writes the description.</li>
          <li>It decides whether a change is one snippet or several.</li>
          <li>It never writes a statement. Those come from the comparison.</li>
          <li>It is optional, and it can be a model your company hosts.</li>
        </ul>
        <p><a class="btn btn-ghost" href="/docs/generated-snippets/">How generation works</a></p>
      </div>
      <div class="names">
        <div class="codebox">
          <div class="codebox-head"><span>Without an LLM</span></div>
          <Code code={plainNames} lang="yaml" themes={themes} />
        </div>
        <div class="codebox">
          <div class="codebox-head"><span>With an LLM</span></div>
          <Code code={llmNames} lang="yaml" themes={themes} />
        </div>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="why">
    <div class="container">
      <h2>Three ways a migration goes wrong</h2>
      <p class="lead">If you have shipped a Java application with a database, you have probably met at least one of them.</p>
      <div class="grid3">
        <div class="card"><h3>“It worked on my empty database.”</h3>
          <p>Adding a mandatory column is easy when the table is empty. In production the table has rows,
          and the statement fails. MIG-Ace runs every migration on a database with data.</p></div>
        <div class="card"><h3>“Hibernate expects something else.”</h3>
          <p>The migration script and the entity classes are written by hand, separately. They drift apart.
          MIG-Ace writes the migration from the difference and proves that none is left.</p></div>
        <div class="card"><h3>“Which version ran where?”</h3>
          <p>Someone fixes an old migration. Now some databases ran the old version and some the new one.
          MIG-Ace records what really ran and lets you repair exactly those databases.</p></div>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="features">
    <div class="container">
      <h2>What you get</h2>
      <p class="lead">Each topic has its own page with short examples.</p>
      <div class="grid3">
        {features.map(([ico, title, text, href]) => (
          <a class="card" href={href}><h3><span class="ico">{ico}</span>{title}</h3><p>{text}</p></a>
        ))}
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="example">
    <div class="container split">
      <div>
        <h2>One example, used everywhere</h2>
        <p>All examples on this site come from the same small application: an online bookshop
          built with Jakarta EE and Hibernate. It is installed at three book stores, and each store
          upgrades when it wants to.</p>
        <p>Over four releases the bookshop gets loyalty levels, reviews, an order status table,
          a renamed column, a hotfix and one migration that went wrong.</p>
        <p><a class="btn btn-ghost" href="/docs/bookshop/">Meet the bookshop</a></p>
      </div>
      <div>
        <h2>How it compares</h2>
        <p>Flyway and Liquibase run the scripts you write and trust that they are right.
          Atlas and Django can write a migration for you. MIG-Ace writes it, asks about your existing
          rows, and then proves the result on a database with data.</p>
        <p>The comparison page also lists what the other tools do better.</p>
        <p><a class="btn btn-ghost" href="/compare/">Compare with other tools</a></p>
      </div>
    </div>
  </section>

  <hr class="sep" />

  <section class="section" id="tech">
    <div class="container">
      <h2>Built with</h2>
      <p class="lead">MIG-Ace stands on a few well-known open-source projects.</p>
      <div class="techgrid">
        {tech.map(([name, text, href]) => (
          <a class="tech" href={href}><b>{name}</b><span>{text}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="card db-note">
        <div>
          <h3>PostgreSQL today</h3>
          <p>This site describes MIG-Ace for PostgreSQL. Snippets are written in a database-neutral
            statement language, so support for other databases can be added later.</p>
        </div>
        <a class="btn btn-primary" href="/docs/getting-started/">Write your first snippet</a>
      </div>
    </div>
  </section>

  <style>
    .hero { position: relative; overflow: hidden; }
    :root[data-theme='light'] .hero-glow { display: none; }
    .hero-glow {
      position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(600px 320px at 78% 30%, rgba(79,156,247,.13), transparent 65%),
        radial-gradient(520px 300px at 88% 80%, rgba(45,212,191,.09), transparent 60%),
        radial-gradient(700px 400px at 12% 8%, rgba(124,108,255,.09), transparent 60%);
    }
    .hero-grid {
      position: relative; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
      gap: 44px; align-items: center; padding-top: 64px; padding-bottom: 68px;
    }
    .badges { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
    .hero h1 { font-size: clamp(2rem, 4vw, 2.9rem); text-wrap: balance; }
    .hero-sub { font-size: 1.13rem; max-width: 540px; margin: 18px 0 28px; }
    .hero-sub b { color: var(--text); }
    .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; }
    .hero-demo { display: grid; gap: 14px; min-width: 0; }
    .hero-demo .codebox { font-size: .8rem; }
    @media (max-width: 980px) { .hero-grid { grid-template-columns: 1fr; padding-top: 44px; padding-bottom: 48px; } }

    .after { margin: 6px 0 0; }

    .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
    #example .split { align-items: start; }
    @media (max-width: 900px) { .split { grid-template-columns: 1fr; gap: 32px; } }
    .split p { max-width: 520px; }
    .split p b { color: var(--text); }
    .ticks { list-style: none; padding: 0; margin: 0 0 1.2em; max-width: 520px; }
    .ticks li { position: relative; padding-left: 26px; margin: .45em 0; color: var(--text-2); }
    .ticks li::before { content: '✓'; position: absolute; left: 0; color: var(--ok); font-weight: 700; }
    .names { display: grid; gap: 14px; min-width: 0; }
    .names .codebox { font-size: .82rem; }

    .techgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 18px; }
    @media (max-width: 900px) { .techgrid { grid-template-columns: 1fr; } }
    .tech {
      display: flex; flex-direction: column; gap: 3px; padding: 14px 16px;
      border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); color: inherit;
    }
    .tech:hover { border-color: var(--blue); color: inherit; }
    .tech b { color: var(--text); font-size: .98rem; }
    .tech span { color: var(--text-2); font-size: .88rem; line-height: 1.5; }

    .db-note { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .db-note h3 { margin-bottom: 6px; }
    .db-note p { max-width: 640px; }
  </style>
</Base>
